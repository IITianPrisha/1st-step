#=====================================
#           SOUND SYSTEM
#=====================================

sound_thread = None
sound_running = False

def stop_sound():
    global sound_running
    sound_running = False

def play_notes(notes, repeat = False):
    global sound_thread
    global sound_running

    stop_sound()
    sound_running = True

    def music():

        global sound_running

        while sound_running:

            for frequency, duration in notes:

                if not sound_running:
                    break

                winsound.Beep(frequency, duration)

                if not repeat:
                    break

    sound_running = False
    sound_thread = threading.Thread(target = music)
    sound_thread.daemon = True
    sound_thread.start()

