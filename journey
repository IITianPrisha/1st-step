def draw_prisha(x,y):

    # Hair
    circle(x, y + 90, 48, "black")

    # Face
    circle(x,y + 95, 35, "peachpuff")

    # Dark blue shirt
    rectangle(x - 35, y, 70, 75, "darkblue")

    # Arms
    artist.color("peachpuff")
    artist.pensize(12)

    artist.penup()
    artist.goto(x - 30,y + 55)
    artist.pendown()
    artist.goto(x - 60, y + 20)

    artist.penup()
    artist.goto(x + 30, y + 55)
    artist.pendown()
    artist.goto(x + 60, y + 20)

    artist.pensize(1)

    # legs
    artist.color("white")
    artist.pensize(14)

    artist.penup()
    artist.goto(x-15, y)
    artist.pendown()
    artist.goto(x-15,y-65)

    artist.penup()
    artist.goto(x+15, y)
    artist.pendown()
    artist.goto(x+15,y-65)

    artist.pensize(1)

