#=====================================
#BASIC FUNCTIONS
#=====================================

def clear_screen():
    artist.clear()
    text.clear()


def write_text(message, x, y, size = 25, style = "normal"):
    text.penup()
    text.goto(x,y)
    text.color("White")
    text.write(message, align="center",font = ("Arial",size,style))


def rectangle(x,y,width,height,color):
    artist.penup()
    artist.goto(x,y)
    artist.setheading(0)
    artist.color(color)
    artist.begin_fill()

    for i in range(2):
        artist.forward(width)
        artist.left(90)
        artist.forward(height)
        artist.left(90)

    artist.end_fill()

def circle(x,y,radius,color):
    artist.penup()
    artist.goto(x,y-radius)
    artist.color(color)
    artist.begin_fill()
    artist.circle(radius)
    artist.end_fill()


