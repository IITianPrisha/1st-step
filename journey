# Scene 1 - morning alarm
def sound_alarm():

    stop_sound()

    def alarm():
        global sound_running
        sound_running = True

        for i in range(3):

            if not sound_running:
                break

            winsound.Beep(900,250)
            winsound.Beep(600,250)
            time.sleep(0.1)

        sound_running = False

    global sound_thread
    sound_thread = threading.Thread(target = alarm)
    sound_thread.daemon = True
    sound_thread.start()

